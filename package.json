{
  "name": "apimobile",
  "version": "1.0.0",
  "description": "",
  "main": "src/app.ts",
  "scripts": {
    "start": "tsx node_modules/knex/bin/cli.js --knexfile src/database/knexfile.ts migrate:latest && tsx src/app.ts",
    "dev": "tsx node_modules/knex/bin/cli.js --knexfile src/database/knexfile.ts migrate:latest && tsx watch src/app.ts",
    "build": "tsc",
    "migrate:latest": "tsx node_modules/knex/bin/cli.js --knexfile src/database/knexfile.ts migrate:latest",
    "migrate:rollback": "tsx node_modules/knex/bin/cli.js --knexfile src/database/knexfile.ts migrate:rollback",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "knex": "^3.2.10",
    "mysql2": "^3.22.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
